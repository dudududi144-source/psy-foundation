{
  "name": "psy-foundation",
  "version": "0.8.0",
  "private": true,
  "description": "Shared musical infrastructure for the PSY device family. Procedural psytrance synthesis engine (in development).",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "cd apps/web && bun run dev",
    "benchmarks": "bun benchmarks/transport-accuracy.ts && bun benchmarks/analysis-accuracy.ts",
    "build": "bun run --filter '*' build",
    "clean": "rm -rf packages/*/dist apps/*/dist apps/web/.next"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
